TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
DATABASE_URL=
BROKER_API_KEY=
BROKER_API_SECRET=
ACCESS_TOKEN=

# Production Upstox token for real-time market-data WebSocket (api.upstox.com).
# UPSTOX_SANDBOX_ACCESS_TOKEN is for sandbox orders only — not market data.
UPSTOX_MARKET_DATA_ACCESS_TOKEN=
# Optional fallback for market data if UPSTOX_MARKET_DATA_ACCESS_TOKEN is unset:
# ACCESS_TOKEN (see above)
# Historical / expired-contract REST API (separate from live WebSocket):
UPSTOX_HISTORICAL_ACCESS_TOKEN=

# Broker selection. Keep PAPER until a client broker is selected and validated.
BROKER=PAPER

# Phase 24 market-data transport (leave blank until broker is selected)
BROKER_WS_URL=
BROKER_WS_TIMEOUT_SECONDS=10

# Phase 34 — Upstox sandbox E2E (explicit opt-in only)
UPSTOX_SANDBOX_ACCESS_TOKEN=
UPSTOX_RUN_REAL_SANDBOX_E2E=false
UPSTOX_SANDBOX_INSTRUMENT=
UPSTOX_SANDBOX_SIDE=BUY
UPSTOX_SANDBOX_QUANTITY=1
UPSTOX_SANDBOX_ORDER_TYPE=MARKET

# Dashboard API protection (required when APP_ENV=production)
APP_ENV=development
DASHBOARD_API_AUTH_REQUIRED=false
DASHBOARD_API_KEY=
